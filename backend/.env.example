# Copy to .env for local dev (git-ignored)
DATABASE_URL=postgresql+asyncpg://sdas:sdas@localhost:5432/sdas
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-me
NONCE_TTL_SECONDS=15
AUTH_WINDOW_SECONDS=60
SCHOOL_EMAIL_DOMAIN=@wku.ac.kr

# CORS: comma-separated allowed web origins. Local dev only needs the Vite
# server; on Render set this to your Vercel URL(s), e.g.
#   CORS_ORIGINS=https://yourapp.vercel.app,https://preview-yourapp.vercel.app
CORS_ORIGINS=http://localhost:5173

# Signup email verification (team member's flow). When SMTP_USER / SMTP_PASSWORD
# are unset, verification codes are logged instead of emailed (dev stub).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Syncattend
