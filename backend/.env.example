# Copy to .env for local dev (git-ignored)
DATABASE_URL=postgresql+asyncpg://sdas:sdas@localhost:5432/sdas
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-me
NONCE_TTL_SECONDS=15
AUTH_WINDOW_SECONDS=60
SCHOOL_EMAIL_DOMAIN=@wku.ac.kr

# Signup email verification (team member's flow). When SMTP_USER / SMTP_PASSWORD
# are unset, verification codes are logged instead of emailed (dev stub).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Syncattend
